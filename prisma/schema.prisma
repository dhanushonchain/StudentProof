generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  googleSub     String    @unique
  email         String
  walletAddress String    @unique
  createdAt     DateTime  @default(now())

  activityEvents      ActivityEvent[]
  verificationRecords VerificationRecord[]
  credentials         Credential[]
  sdkAuthCodes        SdkAuthCode[]
}

model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventType String   // "login" | "logout" | "wallet_created" | "verification_completed" | "credential_issued"
  metadata  Json?
  timestamp DateTime @default(now())
}

model VerificationRecord {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  provider       String    // "reclaim"
  status         String    // "pending" | "verified" | "failed"
  proofReference String?
  reclaimSessionId String?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  // Credential-issuance lifecycle — deliberately separate from the
  // proof-verification `status` above. A valid proof must never be marked
  // invalid because minting failed, and a verified student must not be
  // shown an issued credential until the mint is chain-confirmed:
  // "not_started" | "pending" | "issued" | "failed".
  // `pending` covers an in-flight attempt and an awaiting retry; the
  // orchestrator's atomic claim (optimistic concurrency on
  // issuanceAttempts) decides which instance owns it. Only the error
  // *category* is persisted here — never raw RPC output, URLs, or keys.
  issuanceStatus    String    @default("not_started")
  issuanceAttempts  Int       @default(0)
  lastIssuanceError String?
  // Transaction hash of the latest broadcast attempt, when known. Used to
  // reconcile ambiguous attempts via getTransactionReceipt before any
  // rebroadcast — never assume a timeout means failure.
  mintTxHash        String?
  issuanceUpdatedAt DateTime? @updatedAt @db.Timestamptz(3)

  issuedCredential Credential?
}

model Business {
  id         String   @id @default(cuid())
  // Identity comes from Google sign-in (a completely separate NextAuth
  // provider id from the student flow — see auth.ts) — googleSub, not email,
  // is the real unique key, same pattern as User. A business signing in
  // never creates or reads a User row, and a student signing in never
  // creates or reads a Business row; the two are fully independent tables
  // keyed off the same kind of identity but never cross-referenced.
  googleSub  String   @unique
  name       String
  email      String
  // The raw key is shown to the business exactly once (their first Google
  // sign-in) and emailed then — only its SHA-256 hash is ever persisted,
  // same principle as not storing a plaintext password. Lookup on incoming
  // requests hashes the presented key and compares against this column.
  apiKeyHash String   @unique
  createdAt  DateTime @default(now())

  usageEvents ApiUsageEvent[]
  apiKeys     BusinessApiKey[]
  sdkClients  SdkClient[]
}

// Self-serve developer API keys (one business → many keys). Only the
// SHA-256 hash is ever persisted; the raw secret is returned exactly once at
// creation and never again. Revocation is a timestamp (rows are kept for
// audit/usage history, never deleted). The legacy single
// `Business.apiKeyHash` column stays for backward compatibility with keys
// issued before this table existed — authenticateApiKey checks both.
model BusinessApiKey {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  keyHash    String    @unique
  // Non-secret identifier shown in the dashboard so a developer can tell
  // keys apart (first 8 chars of the raw key, e.g. "sp_live_"). It cannot be
  // used to authenticate — only the full hash matches.
  keyPrefix  String
  label      String    @default("Default")
  revokedAt  DateTime? @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now())

  usageEvents ApiUsageEvent[]
}

// One row per successful (API-key-authenticated) call to a public
// verification endpoint. Deliberately minimal for now — just enough to
// answer "which business, how many requests" — extend with an endpoint/cost
// field later if usage-based billing needs more granularity.
model ApiUsageEvent {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  // Which multi-key row authenticated the call, when known. NULL for calls
  // made with a legacy single-column key (Business.apiKeyHash) — those still
  // count toward the business total, just without per-key attribution.
  businessApiKeyId String?
  businessApiKey   BusinessApiKey? @relation(fields: [businessApiKeyId], references: [id])
  timestamp  DateTime @default(now())
}

model Credential {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  contractAddress String
  tokenId         String
  status          String   // "active" | "revoked"
  issuedAt        DateTime @default(now())
  // Existing rows predate this column and get backfilled to now() — they're
  // already-abandoned testnet data on prior contract addresses, so reading
  // as immediately "expired" is accurate enough. Every row minted from here
  // on always sets a real computed value explicitly (see markVerified).
  // Compared against live time on every read (see toCredentialDTO), so this
  // must be an unambiguous instant — hence timestamptz, not naive timestamp.
  // Display-only dates (issuedAt/verifiedAt/createdAt) stay naive TIMESTAMP.
  expiresAt       DateTime @default(now()) @db.Timestamptz(3)
  // Which verification record this credential was issued for. The UNIQUE
  // constraint is the database-level duplicate-mint guard: at most one
  // credential row may ever reference a record, so two concurrent issuance
  // attempts for the same record cannot both persist (the loser catches the
  // unique violation and reconciles to issued instead of re-minting).
  // NULL for rows minted before this column existed.
  verificationRecordId String?             @unique
  verificationRecord   VerificationRecord? @relation(fields: [verificationRecordId], references: [id])
}

// Third-party SDK clients (manual registration for v1 — no self-serve UI).
// Fully separate from student (User) and business (Business/API-key) tables:
// a client row identifies a relying application, never a student, and SDK
// codes/assertions never intersect API-key auth.
model SdkClient {
  id               String    @id @default(cuid())
  // Public identifier (e.g. sp_client_...). Raw client secrets are shown
  // once at registration; only the SHA-256 hash is ever persisted —
  // the same discipline as business API keys.
  clientId         String    @unique
  clientSecretHash String
  name             String
  websiteUrl       String?
  businessId       String?
  business         Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Exact-match allowlist for redirect_uri validation. Stored as native
  // Postgres TEXT[]; every authorize/token call must match one entry
  // byte-for-byte (production: https only, localhost only in development).
  redirectUris     String[]
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now())

  authCodes SdkAuthCode[]
}

// Single-use authorization codes for the SDK code flow (M2/M3 endpoints).
// Only the SHA-256 hash is persisted; the raw code travels once in a
// same-redirect 302. Redemption must be atomic (single conditional write)
// so concurrent token calls cannot both consume one code.
model SdkAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  client        SdkClient @relation(fields: [clientId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  // Bound at issuance: the token call must present the identical URI.
  redirectUri   String
  // PKCE S256 challenge (base64url of SHA-256 over the verifier).
  codeChallenge String
  // Instant-valued columns compared against live time (expiry gate + atomic
  // redemption guard) must be unambiguous: timestamptz stores the absolute
  // instant regardless of app/database session timezones. Display-only
  // createdAt stays naive TIMESTAMP.
  expiresAt     DateTime @db.Timestamptz(3)
  usedAt        DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now())
}
